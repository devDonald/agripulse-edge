# Meta Model API (dev.meta.ai — usage is metered on the dashboard per model ID)
# Get your key at https://dev.meta.ai — set MODEL_API_KEY to spend live credits.
META_API_URL=https://api.meta.ai/v1/chat/completions
META_API_KEY=
MODEL_API_KEY=
META_MODEL=meta/llama-3.2-90b-vision-instruct
# Supported model IDs (see backend/services/meta_models.py):
#   meta/llama-3.2-90b-vision-instruct (cloud deep pathology)
#   meta/llama-3.2-11b-vision-instruct (cloud fast vision)
#   meta/llama-3.2-3b-instruct          (ExecuTorch on-device INT8)
#   meta/llama-3.2-1b-instruct          (ExecuTorch on-device INT4)
#   meta/sam-2-hiera-large              (SAM 2 cloud segmentation)
# Set to true to skip real API calls and return a schema-valid mock (for CI / offline dev)
MOCK_MODE=false
# Optional: request timeout in seconds
META_TIMEOUT=60
# SAM 2 segmentation endpoint (optional; offline HSV fallback used when empty or MOCK_MODE=true)
SAM2_API_URL=
SAM2_API_KEY=
SAM2_MODEL=sam-2-large
SAM2_TIMEOUT=60
SEG_MAX_DIM=800

